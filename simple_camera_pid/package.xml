<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simple_camera_pid</name>
  <version>0.1.0</version>
  <description>Camera-based baseline PID line follower for the simple camera track.</description>
  <maintainer email="kevin@todo.todo">kevin</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Machine-specific dependencies.

       This package ships four deployment lines (Gazebo / MuJoCo / real robot /
       training) from one tree, but any given machine only runs some of them,
       and their ROS dependencies are not co-installable in practice: the
       Raspberry Pi cannot get ros_gz_sim, the PC has no reason to pull the
       robot's camera/base drivers. Declaring all of them unconditionally made
       `rosdep install` fail on whichever machine wasn't the one they were
       written for, which is why this package was for a while maintained as
       a hand-slimmed fork on the Pi (see the 2026-08-08 merge commit for what
       that cost). Format 3's `condition` attribute expresses the same split
       without forking the tree: the files stay identical on every machine,
       only the environment differs.

       Set this in the robot's ~/.bashrc:
         robot: export SIMPLE_CAMERA_PID_ROBOT=1
       With it unset, rosdep resolves only the core dependencies above, which
       is what the PC wants: the remaining deployment line there is MuJoCo,
       whose extra dependencies are all pip, not ROS (see
       requirements-sim.txt). The Gazebo line, which was the only reason this
       package ever needed ros_gz_sim/turtlebot3_gazebo, was removed on
       2026-08-08; its single-process control node was the real robot's too
       and now lives at simple_camera_pid/real/line_follower_node.py.

       NOTE: `colcon build` does not resolve exec_depend at all; these only
       affect `rosdep install`. Building this package has never required any
       of them. -->

  <!-- Real-robot line: launch/real/robot_bringup.launch.py loads
       camera::CameraNode from camera_ros, starts turtlebot3_node's
       turtlebot3_ros, and reads turtlebot3_bringup's burger.yaml. -->
  <exec_depend condition="$SIMPLE_CAMERA_PID_ROBOT == 1">camera_ros</exec_depend>
  <exec_depend condition="$SIMPLE_CAMERA_PID_ROBOT == 1">turtlebot3_node</exec_depend>
  <exec_depend condition="$SIMPLE_CAMERA_PID_ROBOT == 1">turtlebot3_bringup</exec_depend>

  <!-- Python dependencies are not rosdep-resolvable. They are layered by what
       a machine actually runs; install the matching one:
         requirements-vision.txt    vision only (the Pi: real/vision_node.py)
         requirements-residual.txt  + loading a trained residual policy (the
                                    PC: real/control_node.py)
         requirements-sim.txt       + MuJoCo physics and RL training (PC/HPC)
       Each includes the one above it, so pick the deepest layer you need. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
