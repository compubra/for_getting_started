<?xml version="1.0" ?>
<!--
  Minimal Gazebo world for the camera-track workflow. Based on ros_gz_sim's
  stock empty.sdf, with the Sensors system added (required for camera/lidar
  sensors to actually render and publish — the stock empty.sdf omits it, so
  robot cameras never produce data there).

  Keeps the stock ground_plane: the spawned track models (model/gazebo/
  tracks/*) are visual-only planes with no collision geometry of their own
  (see model/gazebo/tracks/README.md and track_world.launch.py) — they are
  spawned 1mm above this plane so they don't z-fight with it. Without this
  plane the robot has nothing to physically stand on.
-->
<sdf version="1.6">
  <world name="track_camera_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 2026-08-02: no <scene> was ever set here, so Gazebo fell back to its
         own default background color -- a bright, fully-desaturated light
         gray (measured ~218/255 in a captured camera frame's upper/horizon
         band). The turtlebot3 camera is mounted level (pitch=0), so roughly
         the top half of its vertical FOV points above the horizon into this
         background, not at the ground_plane below (that part was already
         fixed, separately, to a dark material). At wide roi_bottom_fraction
         values the ROI's top edge sits close to the horizon line, so this
         bright background was an additional, independent source of
         brightness+low-saturation false positives in the line-detection
         mask -- same class of bug as the ground_plane fix above, different
         part of the frame. Dark background avoids it regardless of ROI
         depth or camera pitch tolerance. -->
    <scene>
      <!-- Background clear-color isn't run through the scene's lighting
           model like a lit surface (ground_plane's 0.05 linear material
           renders to ~5/255 through that pipeline); it appears to go
           through straight sRGB gamma encoding instead, so 0.15 linear
           measured ~108/255 in a captured frame -- well above the vision
           mask's brightness ceiling. 0.01 measured dark enough in practice;
           see this file's git history/session notes if it ever needs
           re-tuning after a Gazebo/Ogre2 version change. -->
      <background>0.01 0.01 0.01 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <!-- 2026-08-02: darkened from a light 0.8/0.8/0.8 gray (rendered
               brightness ~204/255, fully desaturated) -- indistinguishable
               from the white line under common/vision.py's brightness+
               low-saturation mask (adaptive threshold caps at 70/255), so
               any camera view that spills past a track model's small finite
               plane (all track models are ~4.4x4.4m, this ground_plane is
               100x100m) onto bare ground_plane got misdetected as line --
               especially during a lost-line moment (no dominant line blob
               left for the largest-connected-component filter to prefer)
               or a wider roi_bottom_fraction (looks farther, more likely to
               clear the track's edge). Dark gray (~31/255) sits well below
               the mask's brightness floor regardless of lighting; low
               specular avoids bright glare spots reintroducing the same
               problem at grazing viewing angles. -->
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
